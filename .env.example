# Copy to .env.local for local development. Never commit real values.

# Postgres connection string (Neon: Dashboard → Connect). Use a different
# database for local/staging and for prod.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Password for /admin/login.
ADMIN_PASSWORD=""

# Signs the admin login cookie. At least 32 random characters:
#   openssl rand -base64 32
# Changing it signs everyone out.
SESSION_SECRET=""

# Optional: also forward each consultation booking to this URL as JSON.
# CONSULTATION_WEBHOOK_URL=""
